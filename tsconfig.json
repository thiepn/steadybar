{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "rootDir": "src", "outDir": "dist/app", "removeComments": true,
    "types": [], "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
