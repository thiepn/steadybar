{
  "name": "steadybar",
  "version": "1.4.1",
  "private": true,
  "description": "Steadybar \u2014 a local-first music practice workspace.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "python3 tests/e2e.py",
    "check": "npm run typecheck && npm test",
    "test:ui": "python3 tests/e2e.py --render",
    "test:visual": "python3 tests/e2e.py --render --visual",
    "test:workbench": "python3 tests/workbench.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thiepn/steadybar.git"
  },
  "bugs": {
    "url": "https://github.com/thiepn/steadybar/issues"
  }
}
